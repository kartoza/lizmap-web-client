                      <Option name="name" type="QString" value=""></Option>
                      <Option name="properties" type="Map">
                        <Option name="outlineWidth" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom >= 9 AND @vector_tile_zoom &lt;= 14 THEN scale_linear(@vector_tile_zoom,9,14,0.6,0.7) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN scale_linear(@vector_tile_zoom,14,15,0.7,1) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN scale_linear(@vector_tile_zoom,15,16,1,1.2) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 17 THEN scale_linear(@vector_tile_zoom,16,17,1.2,2.1) * 0.264583 WHEN @vector_tile_zoom > 17 THEN 0.555625 END"></Option>
                          <Option name="type" type="int" value="3"></Option>
                        </Option>
                      </Option>
                      <Option name="type" type="QString" value="collection"></Option>
                    </Option>
                  </data_defined_properties>
