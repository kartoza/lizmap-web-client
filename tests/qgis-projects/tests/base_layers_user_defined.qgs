                      <Option name="name" type="QString" value=""></Option>
                      <Option name="properties" type="Map">
                        <Option name="fillColor" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom &lt; 14 THEN color_hsla(0, 73, 88, 255) WHEN @vector_tile_zoom >= 14 AND @vector_tile_zoom &lt; 15 THEN color_hsla(0, scale_linear(@vector_tile_zoom,14,15,73,58), scale_linear(@vector_tile_zoom,14,15,88,92), 255) WHEN @vector_tile_zoom >= 15 THEN color_hsla(0, 58, 92, 255) ELSE color_hsla(0, 58, 92, 255) END"></Option>
                          <Option name="type" type="int" value="3"></Option>
                        </Option>
                        <Option name="outlineColor" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom &lt; 14 THEN color_hsla(0, 83, 81, 255) WHEN @vector_tile_zoom >= 14 AND @vector_tile_zoom &lt; 15 THEN color_hsla(0, scale_linear(@vector_tile_zoom,14,15,83,80), scale_linear(@vector_tile_zoom,14,15,81,84), 255) WHEN @vector_tile_zoom >= 15 THEN color_hsla(0, 80, 84, 255) ELSE color_hsla(0, 80, 84, 255) END"></Option>
                          <Option name="type" type="int" value="3"></Option>
                        </Option>
                      </Option>
                      <Option name="type" type="QString" value="collection"></Option>
                    </Option>
