                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="array_to_string(array_foreach(array(4,7),@element * (CASE WHEN @vector_tile_zoom >= 14 AND @vector_tile_zoom &lt;= 15 THEN scale_linear(@vector_tile_zoom,14,15,1,1.2) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN scale_linear(@vector_tile_zoom,15,16,1.2,1.4) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 17 THEN scale_linear(@vector_tile_zoom,16,17,1.4,2) * 0.264583 WHEN @vector_tile_zoom > 17 THEN 0.529167 END)), ';')"></Option>
