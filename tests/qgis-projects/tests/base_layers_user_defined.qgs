                    <Option type="Map">
                      <Option name="name" type="QString" value=""></Option>
                      <Option name="properties" type="Map">
                        <Option name="fillColor" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom &lt; 12 THEN set_color_part(@symbol_color, 'alpha', 255) WHEN @vector_tile_zoom >= 12 AND @vector_tile_zoom &lt; 13 THEN set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,12,13,255,229.5)) WHEN @vector_tile_zoom >= 13 AND @vector_tile_zoom &lt; 14 THEN set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,13,14,229.5,127.5)) WHEN @vector_tile_zoom >= 14 THEN set_color_part(@symbol_color, 'alpha', 127.5) END"></Option>
                          <Option name="type" type="int" value="3"></Option>
                        </Option>
                        <Option name="outlineColor" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom &lt; 12 THEN set_color_part(@symbol_color, 'alpha', 255) WHEN @vector_tile_zoom >= 12 AND @vector_tile_zoom &lt; 13 THEN set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,12,13,255,229.5)) WHEN @vector_tile_zoom >= 13 AND @vector_tile_zoom &lt; 14 THEN set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,13,14,229.5,127.5)) WHEN @vector_tile_zoom >= 14 THEN set_color_part(@symbol_color, 'alpha', 127.5) END"></Option>
                          <Option name="type" type="int" value="3"></Option>
                        </Option>
                      </Option>
                      <Option name="type" type="QString" value="collection"></Option>
                    </Option>
