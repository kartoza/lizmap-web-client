                    <Option name="customdash_map_unit_scale" type="QString" value="3x:0,0,0,0,0,0"></Option>
                    <Option name="customdash_unit" type="QString" value="MM"></Option>
                    <Option name="dash_pattern_offset" type="QString" value="0"></Option>
